# CallingClaw — Configuration
#
# Setup: ./scripts/setup.sh (copies this to .env)
# Usage: edit .env, then ./scripts/start.sh

# ─── API Keys ──────────────────────────────────────────────

# OpenAI (REQUIRED — Realtime voice + GPT-4o vision)
OPENAI_API_KEY=sk-xxx

# OpenRouter (RECOMMENDED — Computer Use, analysis, vision)
# OPENROUTER_API_KEY=sk-or-v1-xxx

# Anthropic (OPTIONAL — direct Claude API for Computer Use)
# ANTHROPIC_API_KEY=sk-ant-xxx

# Grok / xAI (OPTIONAL — alternative voice provider, 6x cheaper)
# XAI_API_KEY=xai-xxx

# Gemini 3.1 Flash Live (OPTIONAL — voice + vision, 10x cheaper than OpenAI)
# GOOGLE_AI_API_KEY=AIza...

# Voice provider: openai | grok | gemini (default: grok)
# VOICE_PROVIDER=grok

# ─── Google Calendar (OPTIONAL) ────────────────────────────

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# ─── Agent Platform ────────────────────────────────────────
# Which agentic backend to use: openclaw | claude-code | codex | hermes | standalone
# Auto-detected if not set (openclaw > claude-code > codex > hermes > standalone)
# AGENT_PLATFORM=hermes

# ─── OpenClaw (OPTIONAL — used when AGENT_PLATFORM=openclaw) ──

# Gateway token (override — defaults to reading from ~/.openclaw/openclaw.json)
# OPENCLAW_GATEWAY_TOKEN=your-token

# ─── Codex (OPTIONAL — used when AGENT_PLATFORM=codex) ────────
# OpenAI Codex CLI / desktop app. Setup: ./scripts/setup-codex.sh
# Models default to ~/.codex/config.toml; override per cognitive task below.
# CODEX_BIN=                                    # custom codex path (default: PATH or /Applications/Codex.app bundle)
# CODEX_MODEL=                                  # one override for all tasks
# CODEX_PREP_MODEL=
# CODEX_RECALL_MODEL=
# CODEX_TASK_MODEL=

# ─── Hermes (OPTIONAL — used when AGENT_PLATFORM=hermes) ──────
# Hermes Agent (NousResearch). Install: ./scripts/setup-hermes.sh
# Models default to OpenRouter ids; override per cognitive task below.
# HERMES_BIN=                                   # custom hermes path (default: PATH or ~/.local/bin/hermes)
# HERMES_PREP_MODEL=openrouter/anthropic/claude-sonnet-4.6
# HERMES_RECALL_MODEL=openrouter/anthropic/claude-haiku-4.5
# HERMES_TASK_MODEL=openrouter/anthropic/claude-sonnet-4.6

# ─── CallingClaw Backend ───────────────────────────────────

PORT=4000
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# Your email (for calendar event attendees)
# USER_EMAIL=you@example.com

# Model overrides (advanced)
# ANALYSIS_MODEL=anthropic/claude-haiku-4-5
# SEARCH_MODEL=anthropic/claude-haiku-4-5
# VISION_MODEL=google/gemini-3-flash-preview

# Computer Use — OFF-MEETING model (latency not user-facing). Default: claude-sonnet-5
# ANTHROPIC_COMPUTERUSE_MODEL=claude-sonnet-5

# Computer Use — IN-MEETING model (LATENCY-SENSITIVE). Default: anthropic/claude-haiku-4-5.
# Opt in to an A/B of Sonnet 5 in-meeting by uncommenting the line below.
# Latency per turn is logged as [ComputerUse][latency] model=... elapsedMs=...
# IN_MEETING_COMPUTERUSE_MODEL=claude-sonnet-5
